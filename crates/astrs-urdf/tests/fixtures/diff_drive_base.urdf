<?xml version="1.0"?>
<!--
  A minimal differential-drive mobile base: a fixed base plate, two
  continuously-rotating drive wheels, and a fixed caster — the canonical
  "mobile robot" URDF shape (analogous to TurtleBot/Husky-family base
  descriptions), kept small and axis-aligned so its forward kinematics is
  hand-derivable.

    base_footprint (root)
       =[base_joint: fixed, origin xyz="0 0 0.1"]=> base_link
    base_link
       =[left_wheel_joint: continuous, axis Y, origin xyz="0 0.2 minus 0.05"]=> left_wheel_link
       =[right_wheel_joint: continuous, axis Y, origin xyz="0 minus 0.2 minus 0.05"]=> right_wheel_link
       =[caster_joint: fixed, origin xyz="0.15 0 minus 0.08"]=> caster_link

  `base_footprint` (rather than `base_link`) as the root matches the real
  ROS navigation-stack convention: a massless ground-projection frame
  separate from the physical chassis frame.

  See tests/diff_drive_base.rs for the independently-derived golden values
  this fixture's forward kinematics is checked against.
-->
<robot name="diff_drive_base">
  <material name="chassis_gray">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.07"/>
    </inertial>
    <visual>
      <geometry><box size="0.4 0.3 0.15"/></geometry>
      <material name="chassis_gray"/>
    </visual>
    <collision>
      <geometry><box size="0.4 0.3 0.15"/></geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="wheel_black"/>
    </visual>
  </link>

  <link name="right_wheel_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="wheel_black"/>
    </visual>
  </link>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="0.02"/></geometry>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0.1"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0.2 -0.05"/>
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 -0.2 -0.05"/>
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <joint name="caster_joint" type="fixed">
    <origin xyz="0.15 0 -0.08"/>
    <parent link="base_link"/>
    <child link="caster_link"/>
  </joint>
</robot>
